{
    "name": "Simple-reader",
    "version": "1.3.0",
    "description": "Modern desktop RSS reader",
    "main": "./dist/electron.js",
    "packageManager": "pnpm@10.17.1",
    "engines": {
        "node": ">=22"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "electron-winstaller",
            "unrs-resolver"
        ],
        "overrides": {
            "underscore": "^1.13.8",
            "underscore.string": "^3.3.5",
            "lovefield>js-yaml": "^3.15.2",
            "@istanbuljs/load-nyc-config>js-yaml": "^3.15.2",
            "js-yaml": "^4.3.2",
            "tar": "^7.5.21",
            "fast-uri": "^3.1.9",
            "@xmldom/xmldom": "^0.8.15",
            "browserslist": "^4.28.7",
            "zod": "^4.6.6",
            "qs": "^6.16.1",
            "pbkdf2": "^3.1.7",
            "handlebars": "^4.7.10",
            "node-gyp>undici": "^6.29.1",
            "brace-expansion@1": "^1.1.21",
            "brace-expansion@2": "^2.1.7",
            "brace-expansion@5": "^5.0.12"
        }
    },
    "scripts": {
        "build": "pnpm run check && webpack --config ./webpack.config.js",
        "electron": "electron ./dist/electron.js",
        "start": "pnpm run build && pnpm run electron",
        "format": "prettier --write .",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "jest",
        "package-win": "electron-builder -w --x64 -p never && electron-builder -w --ia32 -p never",
        "package-win-ci": "electron-builder -w --x64 -p never",
        "package-mac": "electron-builder --mac --x64 -p never",
        "package-linux": "electron-builder --linux --x64 -p never",
        "check": "tsc --noEmit",
        "dev": "webpack --config ./webpack.config.js --env dev"
    },
    "keywords": [],
    "author": "Evarle Zhuo",
    "license": "BSD-3-Clause",
    "repository": "github:Mrzhuo2022/Simple-reader",
    "devDependencies": {
        "@fluentui/react": "^8.125.1",
        "@reduxjs/toolkit": "^2.10.1",
        "@seald-io/nedb": "^4.1.2",
        "@types/jest": "^30.0.0",
        "@types/lovefield": "^2.1.3",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "@types/react-redux": "^7.1.9",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "electron": "^42.11.16",
        "electron-builder": "^26.0.12",
        "electron-store": "^5.2.0",
        "electron-window-state": "^5.0.3",
        "esbuild-loader": "^4.5.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "font-list": "^1.4.2",
        "html-webpack-plugin": "^5.5.3",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.4.1",
        "js-md5": "^0.7.3",
        "lovefield": "^2.1.12",
        "node-polyfill-webpack-plugin": "^2.0.1",
        "prettier": "2.3.2",
        "qrcode.react": "^1.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-intl-universal": "^2.2.5",
        "react-redux": "^8.1.3",
        "redux": "^4.2.1",
        "redux-thunk": "^2.3.0",
        "reselect": "^4.0.0",
        "rss-parser": "^3.13.0",
        "ts-jest": "^29.4.5",
        "ts-loader": "^7.0.4",
        "typescript": "^5.9.3",
        "webpack": "^5.103.0",
        "webpack-cli": "^6.0.1"
    }
}
